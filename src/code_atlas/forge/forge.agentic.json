    },
    {
      "id": "tests/fixtures/gen_large_repo.py",
      "kind": "fixture",
      "location": "tests/fixtures/gen_large_repo.py",
      "format": "python",
      "resource_class": "test-only"
    },
    {
      "id": "tests/fixtures/pyspark_repo",
